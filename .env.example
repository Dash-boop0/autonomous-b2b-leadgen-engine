# Copy to .env (backend reads ../.env and ./.env). Nothing here is required for the demo.

# App
APP_MODE=demo
SECRET_KEY=change-me-to-a-long-random-string        # signs demo session tokens
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database: SQLite by default; Postgres via Docker Compose or Neon (postgres:// URLs are accepted)
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://leadgen:leadgen@localhost:5442/leadgen
SEED_PROFILE=basic                                   # basic | full
AUTO_BOOTSTRAP=true                                  # migrate + seed-if-empty on first request

# Ports (local scripts / compose). dev.sh falls back to 8100/3100 if these are busy.
API_PORT=8000
WEB_PORT=3000
POSTGRES_HOST_PORT=5442

# Workflow engine (request-driven ticks)
TICK_BUDGET_SECONDS=7
RUN_LEASE_SECONDS=30
RETRY_BASE_SECONDS=2

# Providers: mock is the default and the only tested option
LLM_PROVIDER=mock                                    # mock | ollama | anthropic (optional, untested)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# ANTHROPIC_API_KEY=                                 # optional; requires `pip install anthropic`
# ANTHROPIC_MODEL=claude-opus-5-5
DNS_PROVIDER=mock                                    # mock | dnspython (optional, untested)

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
